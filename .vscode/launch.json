{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            // דיבאג של ה-API (C# Dev Kit): בונה, מריץ עם פרופיל http מ-launchSettings.json ומחבר debugger
            "name": "API (C#)",
            "type": "dotnet",
            "request": "launch",
            "projectPath": "${workspaceFolder}/api/StudentsApi.csproj",
            "launchConfigurationId": "TargetFramework=;http"
        },
        {
            // דיבאג של Angular: מריץ ng serve (מ-tasks.json), פותח Chrome ומחבר debugger ל-TypeScript
            "name": "Client (Angular)",
            "type": "chrome",
            "request": "launch",
            "preLaunchTask": "npm: start - client",
            "url": "http://localhost:4200/",
            "webRoot": "${workspaceFolder}/client"
        }
    ]
}
